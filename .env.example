# CyberScape — example environment
# Copy to `.env` and adjust. Never commit a filled-in `.env`.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL of the web client (used for CORS).
CORS_ORIGIN=http://localhost:5173

# ---- Rate limiting ---------------------------------------------------------
# Window in milliseconds and maximum requests per window per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Client ----------------------------------------------------------------
# Vite dev server proxies /api to the API URL below.
VITE_API_URL=http://localhost:4000
