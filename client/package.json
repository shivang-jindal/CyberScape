    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
